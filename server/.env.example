# ---- Server -------------------------------------------------------
PORT=5000
NODE_ENV=development

# ---- Database (PostgreSQL) ---------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=smart_workforce

# ---- Authentication -----------------------------------------------
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# ---- Frontend origin allowed by CORS ------------------------------
CLIENT_ORIGIN=http://localhost:5173