# Copy to .env and replace every placeholder. Never commit .env.

# ---- Server -------------------------------------------------------
PORT=5000
NODE_ENV=development

# ---- Database (PostgreSQL) ---------------------------------------
# The application should connect as a LEAST-PRIVILEGE role: granted
# SELECT/INSERT/UPDATE/DELETE on the existing objects, but no CREATE or
# DROP, so a compromised API process cannot alter the schema.
DB_HOST=localhost
DB_PORT=5432
DB_USER=CHANGE_ME_app_role
DB_PASSWORD=CHANGE_ME
DB_NAME=smart_workforce

# ---- Database admin (installer only, never used by the running app) --
# Used only by `npm run db:setup` / `npm run db:reset`.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=CHANGE_ME

# ---- Authentication -----------------------------------------------
# Must be a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this invalidates every token that has been issued.
JWT_SECRET=CHANGE_ME_generate_a_64_char_hex_string
JWT_EXPIRES_IN=8h

# ---- Frontend origin allowed by CORS ------------------------------
# Comma-separated for multiple origins.
CLIENT_ORIGIN=http://localhost:5173
